#!/bin/sh
#- Termux has no /usr/bin/env and /bin/sh is Android's mksh, so re-exec under bash.
if [ -z "${BASH_VERSION:-}" ]; then exec bash "$0" "$@"; fi
#
# immich -- run the Immich docker-compose stack on Android/Termux without Docker.
#
# Android denies unprivileged namespaces, so Docker/Podman cannot exist here. This
# launcher instead uses proot (ptrace, no namespaces) to run the *official* arm64 OCI
# images from docker-compose.yaml, sharing Termux's network namespace so the services
# talk over 127.0.0.1 exactly like they would on a compose bridge network.
#
# Usage: immich <command> [args]
#   install [--with-ml]   bootstrap: deps, plan, pull images, timezone
#   plan                  parse docker-compose.yaml -> run/*.json
#   pull [svc...] [--force]
#   up [svc...]           start (ml only with --with-ml / WITH_ML=1)
#   down                  stop everything (reverse order)
#   restart [svc...]
#   status                table of services
#   supervise             keep the stack running (restarts dead services)
#   service [install|uninstall|status]  runit/termux-services autostart (survives reboot)
#   tunnel [up|down|status|token|logs]  Cloudflare Tunnel (cloudflared) for remote access
#   logs <svc> [lines]    show log; `-f` follows
#   shell <svc>           interactive shell in the service rootfs
#   exec <svc> -- cmd...  run a command inside the service rootfs
#   env <svc>             resolved container environment
#   url [svc]             print service URL
#   doctor                diagnostics
#   prune                 delete the downloaded layer cache
#   version
#
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="${IMMICH_TERMUX_ROOT:-$SELF_DIR}"
COMPOSE="${COMPOSE_FILE:-$ROOT/docker-compose.yaml}"
CONF_FILE="$ROOT/immich.conf"
PY="${IMMICH_PYTHON:-python3}"

if [ -f "$CONF_FILE" ]; then
  # shellcheck disable=SC1090
  . "$CONF_FILE"
fi

: "${WITH_ML:=0}"
: "${ARCH:=arm64}"
: "${DNS_SERVERS:=1.1.1.1 8.8.8.8 9.9.9.9}"
: "${NODE_HEAP_MB:=768}"
: "${IMMICH_BIND_HOST:=0.0.0.0}"
: "${TZ:=}"
: "${PG_LOW_MEM:=1}"
: "${HEALTH_TIMEOUT:=180}"

# Cloudflare Tunnel: the tunnel is created in the Cloudflare dashboard and identified
# by a token, so no cert.pem / config.yml is needed here.
: "${TUNNEL_HOSTNAME:=}"       # public hostname from the dashboard (only used to print URLs)
: "${TUNNEL_PROTOCOL:=}"       # quic (cloudflared default) or http2 if UDP is blocked
: "${TUNNEL_METRICS_PORT:=20241}"

TUNNEL_TOKEN_FILE="$ROOT/cloudflared.token"
TUNNEL_PID="$ROOT/run/cloudflared.pid"
TUNNEL_LOG="$ROOT/logs/cloudflared.log"

export IMMICH_TERMUX_ROOT="$ROOT"

C_RED='\033[31m'; C_GRN='\033[32m'; C_YEL='\033[33m'; C_DIM='\033[2m'; C_OFF='\033[0m'
[ -t 1 ] || { C_RED=''; C_GRN=''; C_YEL=''; C_DIM=''; C_OFF=''; }

info()  { printf '%s\n' "$*"; }
warn()  { printf "${C_YEL}warn:${C_OFF} %s\n" "$*" >&2; }
err()   { printf "${C_RED}error:${C_OFF} %s\n" "$*" >&2; }
dim()   { printf "${C_DIM}%s${C_OFF}\n" "$*"; }
ok()    { printf "${C_GRN}%s${C_OFF}\n" "$*"; }

ORDER_FILE="$ROOT/run/order"

ensure_plan() {
  local plan="$ROOT/plan.json"
  if [ ! -f "$ORDER_FILE" ] || [ ! -f "$plan" ] \
     || [ "$COMPOSE" -nt "$plan" ] || [ "$ROOT/lib/compose2plan.py" -nt "$plan" ]; then
    cmd_plan >/dev/null || return 1
  fi
  return 0
}

service_list() {
  if [ -f "$ORDER_FILE" ]; then
    cat "$ORDER_FILE"
  else
    err "no plan yet -- run: immich plan"
    return 1
  fi
}

svc_spec()      { printf '%s/run/%s.json' "$ROOT" "$1"; }
svc_field()     { "$PY" -c 'import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2]) or "")' "$(svc_spec "$1")" "$2"; }
svc_role()      { svc_field "$1" role; }
svc_image()     { svc_field "$1" image; }
svc_port()      { "$PY" -c 'import json,sys
s=json.load(open(sys.argv[1]));p=s.get("ports") or []
print(p[0]["container"] if p else (s.get("default_port") or ""))' "$(svc_spec "$1")"; }
svc_hostport()  { "$PY" -c 'import json,sys
s=json.load(open(sys.argv[1]));p=s.get("ports") or []
print((p[0]["host"] if p else (s.get("default_port") or "")))' "$(svc_spec "$1")"; }
svc_depends()   { "$PY" -c 'import json,sys
print(" ".join(json.load(open(sys.argv[1])).get("depends_on") or []))' "$(svc_spec "$1")"; }

enabled_services() {
  local svc
  for svc in $(service_list); do
    if [ "$(svc_role "$svc")" = "ml" ] && [ "$WITH_ML" != "1" ]; then
      continue
    fi
    printf '%s\n' "$svc"
  done
}

require_python() {
  if ! command -v "$PY" >/dev/null 2>&1; then
    err "python3 not found. Install it with: pkg install python"
    exit 1
  fi
}

cmd_version() {
  local ver="0.1.0"
  local compose_ver="$(svc_field immich-server image 2>/dev/null || true)"
  info "immich-termux $ver  (dockerless compose runner for Android/Termux)"
  [ -n "$compose_ver" ] && dim "compose image: $compose_ver"
}

cmd_plan() {
  require_python
  "$PY" "$ROOT/lib/compose2plan.py" --compose "$COMPOSE" --root "$ROOT" --arch "$ARCH"
}

pull_args() {
  local args=("--root" "$ROOT" "--arch" "$ARCH")
  local force=0 svc
  for svc in "$@"; do
    case "$svc" in
      --force) force=1 ;;
      --*)
        ;;
      *) args+=("--spec" "run/$svc.json") ;;
    esac
  done
  [ "$force" = 1 ] && args+=("--force")
  if [ "${#args[@]}" = 3 ]; then
    args+=("--all")
  fi
  "$PY" "$ROOT/lib/oci_pull.py" "${args[@]}"
}

cmd_pull() {
  require_python
  ensure_plan || return 1
  pull_args "$@"
}

cmd_install() {
  local with_ml=0 arg
  for arg in "$@"; do
    [ "$arg" = "--with-ml" ] && with_ml=1
  done

  info "==> checking Termux dependencies"
  local missing=()
  command -v proot   >/dev/null 2>&1 || missing+=(proot)
  command -v "$PY"   >/dev/null 2>&1 || missing+=(python)
  command -v tar     >/dev/null 2>&1 || missing+=(tar)
  command -v curl    >/dev/null 2>&1 || missing+=(curl)
  if [ "${#missing[@]}" -gt 0 ]; then
    info "    installing: ${missing[*]}"
    pkg install -y "${missing[@]}" || { err "pkg install failed"; return 1; }
  else
    dim "    proot, python, tar, curl present"
  fi

  mkdir -p "$ROOT"/{rootfs,run,logs,volumes,cache/blobs,tmp}

  info "==> translating $COMPOSE"
  cmd_plan || return 1

  info "==> pulling images (anonymous OCI pull, no docker)"
  if [ "$WITH_ML" = 1 ]; then
    pull_args --all || return 1
  else
    # machine learning is skipped by default: it needs ~2 GB extra RAM. Pull it later
    # with: immich pull immich-machine-learning
    pull_args $(enabled_services) || return 1
  fi

  info "==> Android SysV shared memory shim"
  if [ -f "$ROOT/shm/libshm-compat.so" ]; then
    dim "    using shm/libshm-compat.so"
  elif command -v clang >/dev/null 2>&1; then
    if (cd "$ROOT/shm" && clang -shared -fPIC -nostdlib -nodefaultlibs -nostartfiles -O2 \
          -Wl,-soname,libshm-compat.so -o libshm-compat.so shm_compat.c) 2>/dev/null; then
      dim "    built shm/libshm-compat.so from source"
    else
      warn "shim build failed; falling back to the bundled binary"
    fi
  fi
  if [ ! -f "$ROOT/shm/libshm-compat.so" ] && [ ! -f "$ROOT/lib/prebuilt/arm64/libshm-compat.so" ]; then
    warn "no SysV shared memory shim found -- PostgreSQL cannot start without it"
    warn "install clang (pkg install clang) and re-run, or drop an aarch64 build into"
    warn "$ROOT/lib/prebuilt/arm64/libshm-compat.so"
  fi

  info "==> container timezone"
  local tz="$TZ"
  [ -z "$tz" ] && tz="$("$PY" -c 'import json,sys
s=json.load(open(sys.argv[1]));print(s["services"].get("immich-server",{}).get("env",{}).get("TZ",""))' "$ROOT/plan.json")"
  if [ -n "$tz" ]; then
    "$PY" -c 'import tzdata' >/dev/null 2>&1 || {
      dim "    installing python tzdata (for /etc/localtime)"
      "$PY" -m pip install --quiet --disable-pip-version-check tzdata 2>/dev/null || warn "pip install tzdata failed; containers will use UTC"
    }
    "$PY" "$ROOT/lib/tzsetup.py" --root "$ROOT" --tz "$tz" || warn "timezone setup incomplete"
  fi

  if [ "$with_ml" = 1 ]; then
    printf '\nWITH_ML=1\n' >> "$CONF_FILE"
    info "==> machine learning enabled in immich.conf"
  fi

  ok "==> install complete"
  info ""
  info "Start the stack:   ./immich up"
  info "Show status:       ./immich status"
  info "Web UI:            http://127.0.0.1:$(svc_port immich-server 2>/dev/null || echo 2283)"
  if command -v cloudflared >/dev/null 2>&1 || [ -f "$ROOT/cloudflared-setup.txt" ]; then
    info "Remote access:     ./immich tunnel token --from-file cloudflared-setup.txt && ./immich tunnel up"
  else
    info "Remote access:     ./immich tunnel install && ./immich tunnel up  (Cloudflare Tunnel)"
  fi
  info ""
  warn "Android may freeze Termux in the background. Run 'termux-wake-lock' (termux-api)"
  warn "and disable battery optimisation for Termux, otherwise the stack will be paused."
}

service_healthy() {
  local svc="$1" role port
  role="$(svc_role "$svc")"
  port="$(svc_port "$svc")"
  if [ -z "$port" ]; then
    err "$svc has no port to probe; re-run: immich plan"
    return 1
  fi
  case "$role" in
    database)
      "$PY" "$ROOT/lib/probe.py" wait-tcp 127.0.0.1 "$port" --timeout "$HEALTH_TIMEOUT" --interval 1
      ;;
    redis)
      "$PY" "$ROOT/lib/probe.py" redis 127.0.0.1 "$port"
      ;;
    server)
      "$PY" "$ROOT/lib/probe.py" http "http://127.0.0.1:$port/api/server/ping" --contains pong --timeout 5
      ;;
    ml)
      "$PY" "$ROOT/lib/probe.py" http "http://127.0.0.1:$port/ping" --contains pong --timeout 5
      ;;
    *)
      "$PY" "$ROOT/lib/probe.py" tcp 127.0.0.1 "$port"
      ;;
  esac
}

wait_healthy() {
  local svc="$1" tries=0 max=$(( HEALTH_TIMEOUT ))
  while [ "$tries" -lt "$max" ]; do
    # the probe complains on every attempt while a slow service boots (each
    # "Connection refused" would land in logs/ or the supervisor's svlogd log);
    # cmd_up prints the log tail if the wait really fails
    if service_healthy "$svc" 2>/dev/null; then
      return 0
    fi
    tries=$(( tries + 1 ))
    sleep 1
  done
  return 1
}

cmd_up() {
  require_python
  ensure_plan || return 1

  local explicit=("$@")
  local svc started=0
  local list

  # a cold start gets a clean /dev/shm, like a fresh container does
  local any_running=0 state
  for svc in $(enabled_services); do
    read -r state _ _ <<<"$(svc_state "$svc")"
    [ "$state" = running ] && any_running=1
  done
  if [ "$any_running" = 0 ]; then
    local cleared
    cleared="$("$PY" "$ROOT/lib/svc.py" --root "$ROOT" clear-shm)"
    [ "${cleared:-0}" -gt 0 ] && dim "cleared /dev/shm (${cleared} stale entries)"
  fi

  if [ "${#explicit[@]}" -gt 0 ]; then
    list="${explicit[*]}"
  else
    list="$(enabled_services)"
  fi

  for svc in $list; do
    if [ ! -f "$(svc_spec "$svc")" ]; then
      err "unknown service: $svc"; return 1
    fi
    info "==> $svc"
    "$PY" "$ROOT/lib/svc.py" --root "$ROOT" start "$svc" || return 1
    if ! wait_healthy "$svc"; then
      err "$svc did not become healthy within ${HEALTH_TIMEOUT}s"
      dim "    last log lines from logs/$svc.log:"
      tail -n 30 "$ROOT/logs/$svc.log" 2>/dev/null | sed 's/^/    /'
      return 1
    fi
    ok "    $svc healthy"
    started=$(( started + 1 ))
  done

  info ""
  ok "$started service(s) running"
  local url
  url="$(cmd_url immich-server 2>/dev/null || true)"
  [ -n "$url" ] && info "Web UI: $url"
  if tunnel_running; then
    local pub; pub="$(tunnel_public_url)"
    [ -n "$pub" ] && info "Public: $pub"
  fi
}

cmd_down() {
  require_python
  local keep_tunnel=0 arg svc list
  for arg in "$@"; do
    [ "$arg" = "--keep-tunnel" ] && keep_tunnel=1
  done
  list="$(service_list 2>/dev/null | tac)"
  for svc in $list; do
    "$PY" "$ROOT/lib/svc.py" --root "$ROOT" stop "$svc" >/dev/null
  done
  # the tunnel exists to expose this stack, so it goes down with it (`restart` keeps it)
  if [ "$keep_tunnel" = 0 ] && [ -f "$TUNNEL_PID" ]; then
    cmd_tunnel_down
  fi
  ok "stopped"
}

cmd_restart() {
  require_python
  local svc
  if [ "${#}" -gt 0 ]; then
    for svc in "$@"; do
      "$PY" "$ROOT/lib/svc.py" --root "$ROOT" stop "$svc" >/dev/null
    done
  else
    cmd_down --keep-tunnel
  fi
  cmd_up "$@"
}

cmd_supervise() {
  require_python
  ensure_plan || return 1
  local interval="${SUPERVISE_INTERVAL:-10}" svc state pid uptime
  # the tunnel is supervised too when it was up, or when a token is configured (a cold
  # boot has no pid file yet, so a token alone has to be enough to bring it back)
  local tunnel_wanted=0 tunnel_note=""
  if [ -f "$TUNNEL_PID" ] || tunnel_token >/dev/null 2>&1; then
    tunnel_wanted=1; tunnel_note=" and the tunnel"
  fi
  # SUPERVISE_STOP_STACK=0 is used by the runit service: runsv restarts us, so a TERM
  # (sv down / sv restart) must not take the whole stack down with it
  trap 'info ""; info "stopping supervisor"
        [ "${SUPERVISE_STOP_STACK:-1}" = 1 ] && cmd_down
        exit 0' INT TERM
  info "supervising the stack${tunnel_note} (interval ${interval}s, Ctrl-C to stop)"
  # an orderly cold start (dependency order + health gating) beats the restart loop
  # below, which would happily start immich-server before Postgres is listening -- this
  # is the path taken after a reboot, when runsv starts this service
  local any_running=0
  for svc in $(enabled_services); do
    read -r state _ _ <<<"$(svc_state "$svc")"
    [ "$state" = running ] && any_running=1
  done
  if [ "$any_running" = 0 ]; then
    info "cold start: bringing the stack up (this takes a few minutes)"
    cmd_up || warn "cold start incomplete -- the loop below will keep retrying"
  fi
  while :; do
    for svc in $(enabled_services); do
      read -r state pid uptime <<<"$(svc_state "$svc")"
      if [ "$state" != running ]; then
        warn "$svc is not running -- restarting"
        "$PY" "$ROOT/lib/svc.py" --root "$ROOT" start "$svc" >/dev/null \
          && dim "    $svc restarted" || warn "    $svc restart failed"
      fi
    done
    if [ "$tunnel_wanted" = 1 ] && ! tunnel_running; then
      warn "cloudflared is not running -- restarting"
      cmd_tunnel_up >/dev/null 2>&1 && dim "    cloudflared restarted" \
        || warn "    cloudflared restart failed (see logs/cloudflared.log)"
    fi
    sleep "$interval"
  done
}

# ------------------------------------------------------------------ cloudflared
#
# `cloudflared` is a single static Go binary that dials *out* to the Cloudflare edge, so
# nothing has to be reachable from the internet and no firewall port is opened -- which is
# what makes it work on an unrooted phone. `cloudflared service install` only exists for
# systemd, so here it is a plain background process with a pid file, like the services.

tunnel_installed() { command -v cloudflared >/dev/null 2>&1; }

# cloudflared only ever appends; keep one generation so the log cannot fill the phone
rotate_log() {
  local f="$1" max_mb="${LOG_MAX_MB:-20}" size
  [ -f "$f" ] || return 0
  size="$(wc -c < "$f" 2>/dev/null || echo 0)"
  [ "${size:-0}" -gt $(( max_mb * 1024 * 1024 )) ] || return 0
  mv -f "$f" "$f.1" && dim "rotated $(basename "$f") (was $(( size / 1048576 )) MB)"
}

tunnel_token_source() {
  if [ -n "${TUNNEL_TOKEN:-}" ]; then printf 'immich.conf (TUNNEL_TOKEN)'
  elif [ -f "$TUNNEL_TOKEN_FILE" ]; then printf '%s' "${TUNNEL_TOKEN_FILE#$ROOT/}"
  elif [ -f "$ROOT/cloudflared-setup.txt" ]; then printf 'cloudflared-setup.txt'
  else printf 'not configured'
  fi
}

tunnel_token() {
  local tok="${TUNNEL_TOKEN:-}" f
  if [ -z "$tok" ] && [ -f "$TUNNEL_TOKEN_FILE" ]; then
    tok="$(tr -d '[:space:]' < "$TUNNEL_TOKEN_FILE")"
  fi
  if [ -z "$tok" ]; then
    for f in "$ROOT/cloudflared-setup.txt" "$ROOT/cloudflared-token.txt"; do
      [ -f "$f" ] || continue
      tok="$(grep -oE '[A-Za-z0-9_-]{100,}' "$f" | head -1)"
      [ -n "$tok" ] && break
    done
  fi
  [ -n "$tok" ] || return 1
  printf '%s' "$tok"
}

# a tunnel token is base64(JSON) of {account tag, tunnel id, secret}: show only the
# identifiers, never the secret
TUNNEL_IDS_PY='import base64,json,sys
tok=sys.argv[1]
try:
    d=json.loads(base64.urlsafe_b64decode(tok + "=" * (-len(tok) % 4)))
    print(d.get("t", "?"), d.get("a", "?"))
except Exception:
    print("? ?")'

tunnel_ids() { "$PY" -c "$TUNNEL_IDS_PY" "$1" 2>/dev/null || printf '? ?'; }

tunnel_pid() {
  [ -f "$TUNNEL_PID" ] || return 1
  local pid
  read -r pid _ < "$TUNNEL_PID" || return 1
  [ -n "$pid" ] && [ -d "/proc/$pid" ] || return 1
  printf '%s' "$pid"
}

tunnel_running() { tunnel_pid >/dev/null 2>&1; }

tunnel_uptime_s() {
  local pid start
  read -r pid start < "$TUNNEL_PID" 2>/dev/null || return 0
  [ -n "${start:-}" ] || return 0
  printf '%s' $(( $(date +%s) - start ))
}

# cloudflared serves a metrics server on loopback; /ready answers 200 once at least one
# connection to the edge is up (503 otherwise) and reports how many there are.
tunnel_ready() {
  "$PY" "$ROOT/lib/probe.py" http "http://127.0.0.1:$TUNNEL_METRICS_PORT/ready" \
      --expect 200 --timeout 3 >/dev/null 2>&1
}

tunnel_connections() {
  curl -sS --max-time 3 "http://127.0.0.1:$TUNNEL_METRICS_PORT/ready" 2>/dev/null |
    "$PY" -c 'import json,sys
try: print(json.load(sys.stdin).get("readyConnections", 0))
except Exception: pass'
}

tunnel_hostname() {
  local host="$TUNNEL_HOSTNAME"
  # a dashboard-managed tunnel logs its ingress on every reconnect, so the public
  # hostname can be recovered without asking the Cloudflare API. In the log the config
  # is printed as an escaped JSON string (config="{\"ingress\":[{\"hostname\"...).
  if [ -z "$host" ] && [ -f "$TUNNEL_LOG" ]; then
    host="$("$PY" - "$TUNNEL_LOG" <<'PY'
import re, sys
try:
    with open(sys.argv[1], errors='replace') as fh:
        text = fh.read().replace('\\"', '"')
except OSError:
    raise SystemExit
hosts = re.findall(r'"hostname"\s*:\s*"([^"]+)"', text)
print(hosts[-1] if hosts else '', end='')
PY
)"
  fi
  printf '%s' "$host"
}

tunnel_public_url() {
  local host; host="$(tunnel_hostname)"
  [ -n "$host" ] && printf 'https://%s\n' "$host"
}

# what the dashboard public hostname must point at: the Immich server on loopback
tunnel_service_target() { printf 'http://127.0.0.1:%s\n' "$(svc_port immich-server 2>/dev/null || echo 2283)"; }

cmd_tunnel_install() {
  if tunnel_installed; then
    dim "cloudflared present: $(cloudflared --version 2>&1 | head -1)"
    return 0
  fi
  info "==> pkg install cloudflared"
  pkg install -y cloudflared || { err "pkg install cloudflared failed"; return 1; }
  ok "    $(cloudflared --version 2>&1 | head -1)"
}

cmd_tunnel_token() {
  local arg="${1:-}" tok
  if [ -z "$arg" ]; then
    tok="$(tunnel_token)" || { info "no tunnel token configured"; return 1; }
    local tid aid; read -r tid aid <<<"$(tunnel_ids "$tok")"
    info "token source : $(tunnel_token_source)"
    info "masked       : ${tok:0:10}...${tok: -6} (${#tok} chars)"
    info "tunnel id    : $tid"
    info "account id   : $aid"
    return 0
  fi
  if [ "$arg" = "--from-file" ]; then
    local f="${2:-}"
    [ -f "$f" ] || { err "no such file: $f"; return 1; }
    tok="$(grep -oE '[A-Za-z0-9_-]{100,}' "$f" | head -1)"
    [ -n "$tok" ] || { err "no tunnel token found in $f"; return 1; }
  else
    case "$arg" in
      *[!A-Za-z0-9_-]*) err "that does not look like a tunnel token (base64url only)"; return 1 ;;
    esac
    [ "${#arg}" -ge 100 ] || { err "token looks too short (${#arg} chars)"; return 1; }
    tok="$arg"
  fi
  mkdir -p "$ROOT/run"
  printf '%s\n' "$tok" > "$TUNNEL_TOKEN_FILE"
  chmod 600 "$TUNNEL_TOKEN_FILE"
  ok "saved $TUNNEL_TOKEN_FILE (mode 600)"
  info "Start it with:  ./immich tunnel up"
}

cmd_tunnel_up() {
  require_python
  tunnel_installed || {
    err "cloudflared is not installed -- run: pkg install cloudflared"
    return 1
  }
  local tok; tok="$(tunnel_token)" || {
    err "no Cloudflare tunnel token"
    dim "    ./immich tunnel token <TOKEN>          # or --from-file cloudflared-setup.txt"
    return 1
  }
  mkdir -p "$ROOT/run" "$ROOT/logs"
  if tunnel_running; then
    info "cloudflared: already running (pid $(tunnel_pid))"
  else
    rotate_log "$TUNNEL_LOG"
    # --no-autoupdate/--metrics are `tunnel`-level flags, so they must precede `run`
    local args=(tunnel --no-autoupdate --metrics "127.0.0.1:$TUNNEL_METRICS_PORT" run --token "$tok")
    [ -n "$TUNNEL_PROTOCOL" ] && args+=(--protocol "$TUNNEL_PROTOCOL")
    # termux-exec exports LD_PRELOAD; children of cloudflared must not inherit it
    env -u LD_PRELOAD nohup cloudflared "${args[@]}" >>"$TUNNEL_LOG" 2>&1 &
    local pid=$!
    printf '%s %s\n' "$pid" "$(date +%s)" > "$TUNNEL_PID"
    info "cloudflared: started (pid $pid)"
  fi

  local i
  for i in $(seq 1 30); do
    tunnel_ready && break
    [ -d "/proc/$(tunnel_pid 2>/dev/null)" ] || break
    sleep 1
  done
  if ! tunnel_ready; then
    err "cloudflared is not ready (no connection to the Cloudflare edge)"
    dim "    last log lines from logs/cloudflared.log:"
    tail -n 15 "$TUNNEL_LOG" 2>/dev/null | sed 's/^/    /'
    return 1
  fi
  # connections come up one by one; give the remaining ones a moment so the report is real
  local conn i2
  for i2 in $(seq 1 10); do
    conn="$(tunnel_connections)"; conn="${conn:-0}"
    [ "$conn" -ge 4 ] 2>/dev/null && break
    sleep 1
  done
  ok "    tunnel ready (${conn:-?} edge connection(s))"
  if [ "${conn:-0}" -lt 4 ] 2>/dev/null; then
    dim "    fewer than 4 connections: cloudflared likes QUIC/UDP, but carrier NAT often"
    dim "    throttles it -- set TUNNEL_PROTOCOL=http2 in immich.conf if this flaps"
  fi

  local url; url="$(tunnel_public_url)"
  if [ -n "$url" ]; then
    info "Public URL: $url"
  else
    warn "no public hostname known yet:"
    dim "    in the dashboard add a public hostname (e.g. immich.example.com, type HTTP)"
    dim "    pointing at $(tunnel_service_target)  -- then set TUNNEL_HOSTNAME in immich.conf"
  fi
}

cmd_tunnel_down() {
  local pid
  if ! pid="$(tunnel_pid)"; then
    rm -f "$TUNNEL_PID"
    info "cloudflared: not running"
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null
  local i
  for i in $(seq 1 20); do
    [ -d "/proc/$pid" ] || break
    sleep 0.5
  done
  if [ -d "/proc/$pid" ]; then
    kill -KILL "$pid" 2>/dev/null
    sleep 0.5
  fi
  rm -f "$TUNNEL_PID"
  ok "cloudflared stopped"
}

cmd_tunnel_status() {
  local pid state uptime ready conns url
  if pid="$(tunnel_pid)"; then
    state="${C_GRN}running${C_OFF}"
    uptime="$(human_uptime "$(tunnel_uptime_s)")"
    conns="$(tunnel_connections)"; conns="${conns:-0}"
    # cloudflared keeps 4 connections to different edge locations; fewer means flapping
    if ! tunnel_ready; then
      ready="${C_RED}dead${C_OFF}"
    elif [ "$conns" -lt 4 ] 2>/dev/null; then
      ready="${C_YEL}degraded${C_OFF}"
    else
      ready="${C_GRN}ready${C_OFF}"
    fi
  else
    state=stopped; pid='-'; uptime='-'; ready='-'; conns='-'
  fi
  url="$(tunnel_public_url)"
  printf '%-22s %-9b %-8s %-10s %-10b %-4s %s\n' cloudflared "$state" "$pid" "$uptime" "$ready" "$conns" "${url:--}"

  local tok tid aid
  if tok="$(tunnel_token)"; then
    read -r tid aid <<<"$(tunnel_ids "$tok")"
    dim "  token        : $(tunnel_token_source)"
    dim "  tunnel id    : $tid"
    dim "  account id   : $aid"
    dim "  ingress      : (dashboard) -> $(tunnel_service_target)"
  else
    dim "  token        : none -- ./immich tunnel token <TOKEN>"
  fi
  if [ "$state" != stopped ] && [ "${conns:-0}" -lt 4 ] 2>/dev/null; then
    dim "  tip          : connections are flapping; on mobile networks UDP is often"
    dim "                 throttled -- set TUNNEL_PROTOCOL=http2 in immich.conf"
  fi
}

cmd_tunnel_logs() {
  local lines="${1:-40}"
  [ -f "$TUNNEL_LOG" ] || { err "no log yet ($TUNNEL_LOG)"; return 1; }
  if [ "$lines" = "-f" ]; then tail -n 40 -f "$TUNNEL_LOG"; else tail -n "$lines" "$TUNNEL_LOG"; fi
}

cmd_tunnel() {
  local sub="${1:-status}"
  shift 2>/dev/null || true
  case "$sub" in
    up|start)       cmd_tunnel_up "$@" ;;
    down|stop)      cmd_tunnel_down "$@" ;;
    restart)        cmd_tunnel_down >/dev/null; cmd_tunnel_up "$@" ;;
    status|ps)      cmd_tunnel_status "$@" ;;
    logs)           cmd_tunnel_logs "$@" ;;
    token)          cmd_tunnel_token "$@" ;;
    install)        cmd_tunnel_install "$@" ;;
    help|-h|--help) usage ;;
    *) err "unknown tunnel command: $sub"; dim "    up | down | restart | status | logs | token | install"; return 1 ;;
  esac
}

svc_state() {
  "$PY" "$ROOT/lib/svc.py" --root "$ROOT" status "$1" 2>/dev/null |
    "$PY" -c 'import json,sys
try: d=json.load(sys.stdin)
except Exception: d={}
print("running" if d.get("running") else "stopped", d.get("pid",""), d.get("uptime_s",""))'
}

human_uptime() {
  local s="$1"
  if [ -z "$s" ]; then printf -- '-'; return; fi
  printf '%02dh%02dm%02ds' $(( s / 3600 )) $(( (s % 3600) / 60 )) $(( s % 60 ))
}

cmd_status() {
  require_python
  ensure_plan || return 1
  printf '%-22s %-9s %-8s %-10s %-7s %-6s %s\n' SERVICE STATE PID UPTIME PORT HEALTH IMAGE
  local svc state pid uptime port health image mark
  for svc in $(service_list); do
    read -r state pid uptime <<<"$(svc_state "$svc")"
    uptime="$(human_uptime "$uptime")"
    port="$(svc_port "$svc")"
    image="$(svc_image "$svc" | sed 's#.*/##')"
    if [ "$state" = running ]; then
      if [ "$(svc_role "$svc")" = ml ] && [ "$WITH_ML" != 1 ]; then
        health="off"
      elif service_healthy "$svc"; then
        health="${C_GRN}ok${C_OFF}"
      else
        health="${C_RED}fail${C_OFF}"
      fi
      mark="${C_GRN}running${C_OFF}"
    else
      health="-"
      mark=stopped
    fi
    printf '%-22s %-9b %-8s %-10s %-7s %-6b %s\n' "$svc" "$mark" "${pid:--}" "$uptime" "${port:--}" "$health" "$image"
  done

  local conn pub
  if tunnel_running; then
    conn="$(tunnel_connections)"; conn="${conn:-0}"
    pub="$(tunnel_public_url)"
    info ""
    info "${C_GRN}tunnel${C_OFF} cloudflared pid $(tunnel_pid), ${conn} edge connection(s)${pub:+ -> $pub}"
  elif tunnel_installed; then
    info ""
    dim "tunnel stopped (./immich tunnel up)"
  fi
}

cmd_logs() {
  local svc="${1:-}" lines="${2:-40}"
  [ -z "$svc" ] && { err "usage: immich logs <service> [lines]"; return 1; }
  local log="$ROOT/logs/$svc.log"
  [ -f "$log" ] || { err "no log for $svc ($log)"; return 1; }
  if [ "$lines" = "-f" ]; then
    tail -n 40 -f "$log"
  else
    tail -n "$lines" "$log"
  fi
}

cmd_shell() {
  require_python
  local svc="${1:-}"
  [ -z "$svc" ] && { err "usage: immich shell <service>"; return 1; }
  "$PY" "$ROOT/lib/svc.py" --root "$ROOT" shell "$svc"
}

cmd_exec() {
  require_python
  local svc="${1:-}"; shift || true
  [ -z "$svc" ] && { err "usage: immich exec <service> -- command"; return 1; }
  "$PY" "$ROOT/lib/svc.py" --root "$ROOT" exec "$svc" -- "$@"
}

cmd_env() {
  require_python
  local svc="${1:-}"
  [ -z "$svc" ] && { err "usage: immich env <service>"; return 1; }
  "$PY" "$ROOT/lib/svc.py" --root "$ROOT" env "$svc"
}

cmd_url() {
  local svc="${1:-immich-server}" port host
  port="$(svc_port "$svc")"; host="$IMMICH_BIND_HOST"
  [ -z "$port" ] && return 1
  if [ "$host" = "0.0.0.0" ]; then
    printf 'http://%s:%s\n' "$(ip_guess)" "$port"
  else
    printf 'http://%s:%s\n' "$host" "$port"
  fi
  # `immich url` is the quickest way to find out where the stack can be reached; the
  # public URL is only printed while the tunnel is actually connected
  local pub
  if tunnel_running; then
    pub="$(tunnel_public_url)"
    [ -n "$pub" ] && printf '%s\n' "$pub"
  fi
  return 0
}

ip_guess() {
  "$PY" - <<'PY'
import socket
try:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.connect(('1.1.1.1', 80))
    print(s.getsockname()[0])
    s.close()
except OSError:
    print('127.0.0.1')
PY
}

cmd_doctor() {
  require_python
  ensure_plan >/dev/null 2>&1 || true
  info "== device =="
  uname -srm | sed 's/^/  /'
  dim "  proot        : $(proot --version 2>&1 | tr -d '\r' | grep -iE '^proot ' | head -1)"
  dim "  python       : $($PY -V 2>&1)"
  dim "  cores        : $(nproc 2>/dev/null || echo '?')"
  local shim
  shim="$ROOT/shm/libshm-compat.so"
  [ -f "$shim" ] || shim="$ROOT/lib/prebuilt/arm64/libshm-compat.so"
  dim "  sysv shim    : ${shim#$ROOT/}"
  if [ -r /proc/meminfo ]; then
    awk '/MemTotal|MemAvailable|SwapTotal|SwapFree/{k=$1; sub(/:$/,"",k); printf "  %-13s: %.2f GiB\n", k, $2/1048576}' /proc/meminfo
  fi
  df -h "$ROOT" | tail -1 | awk '{printf "  storage      : %s free of %s\n", $4, $2}'

  info ""
  info "== kernel capability =="
  if unshare -m true 2>/dev/null; then
    dim "  unshare -m   : allowed (a container runtime might work)"
  else
    dim "  unshare -m   : denied -> docker/podman impossible, proot used instead"
  fi

  info ""
  info "== plan =="
  if [ -f "$ORDER_FILE" ]; then
    local svc
    for svc in $(service_list); do
      local rootfs image digest size
      rootfs="$ROOT/rootfs/$svc"
      image="$(svc_image "$svc")"
      if [ -d "$rootfs" ]; then
        size="$(du -sh "$rootfs" 2>/dev/null | cut -f1)"
        digest="$("$PY" -c 'import json,sys
try: print((json.load(open(sys.argv[1])).get("config_digest") or "")[:19])
except Exception: print("")' "$rootfs/.immich-image.json" 2>/dev/null || true)"
      else
        size="-"; digest="-"
      fi
      printf '  %-22s %-8s %-8s %s\n' "$svc" "${size:--}" "${digest:--}" "$image"
    done
  else
    warn "  no plan -- run: immich plan"
  fi

  info ""
  info "== configured ports =="
  local svc uid_line
  for svc in $(service_list 2>/dev/null); do
    local port state
    port="$(svc_port "$svc")"
    if "$PY" "$ROOT/lib/probe.py" tcp 127.0.0.1 "$port"; then state=busy; else state=free; fi
    printf '  %-22s %-6s %s\n' "$svc" "$port" "$state"
  done

  info ""
  info "== tunnel (cloudflared) =="
  if tunnel_installed; then
    dim "  binary       : $(cloudflared --version 2>&1 | head -1)"
  elif command -v pkg >/dev/null 2>&1; then
    dim "  binary       : not installed (pkg install cloudflared)"
  else
    dim "  binary       : not installed"
  fi
  if tunnel_token >/dev/null 2>&1; then
    local tid aid
    read -r tid aid <<<"$(tunnel_ids "$(tunnel_token)")"
    dim "  token        : $(tunnel_token_source)"
    dim "  tunnel id    : $tid"
  else
    dim "  token        : none -- ./immich tunnel token <TOKEN>"
  fi
  if tunnel_running; then
    local conn
    conn="$(tunnel_connections)"; conn="${conn:-0}"
    dim "  state        : running (pid $(tunnel_pid), ${conn} edge connection(s))"
    dim "  ready probe  : 127.0.0.1:$TUNNEL_METRICS_PORT/ready $(tunnel_ready && echo ok || echo fail)"
  else
    dim "  state        : stopped"
  fi
  local pub; pub="$(tunnel_public_url)"
  dim "  public url   : ${pub:-unknown (set TUNNEL_HOSTNAME in immich.conf)}"
  dim "  ingress      : dashboard -> $(tunnel_service_target)"

  info ""
  info "== settings =="
  dim "  root         : $ROOT"
  dim "  compose      : $COMPOSE"
  dim "  WITH_ML      : $WITH_ML"
  dim "  DNS_SERVERS  : $DNS_SERVERS"
  dim "  NODE_HEAP_MB : $NODE_HEAP_MB"
  dim "  PG_LOW_MEM   : $PG_LOW_MEM"
  [ -f "$CONF_FILE" ] && dim "  immich.conf  : $CONF_FILE"
}

cmd_prune() {
  local size
  size="$(du -sh "$ROOT/cache" 2>/dev/null | cut -f1)"
  rm -rf "$ROOT"/cache/blobs/*
  ok "pruned layer cache (${size:-0} freed). Rootfs directories are kept."
}

# ---------------------------------------------------------------- runit service
#
# Android starts nothing by itself and a foreground `supervise` launched from
# Termux:Boot dies with that app. `termux-services` already runs a runsvdir that
# survives the screen going off and restarts its children, so the supervisor is
# registered there and Termux:Boot only has to make sure it is up.

SERVICE_NAME=immich

cmd_service() {
  local action="${1:-status}"
  local prefix="${PREFIX:-/data/data/com.termux/files/usr}"
  local svdir="${SVDIR:-$prefix/var/service}"
  local logdir="${LOGDIR:-$prefix/var/log}"
  local dir="$svdir/$SERVICE_NAME"
  local log="$logdir/$SERVICE_NAME"

  case "$action" in
    install)
      if [ ! -d "$svdir" ]; then
        err "$svdir not found -- install termux-services first: pkg install termux-services"
        return 1
      fi
      # runsv does not inherit a login environment: without TZ, svlogd stamps every line
      # in UTC. Take the same timezone the containers get (immich.conf, else compose).
      local tz="${TZ:-}"
      [ -z "$tz" ] && tz="$("$PY" -c 'import json,sys
s=json.load(open(sys.argv[1]));print(s["services"].get("immich-server",{}).get("env",{}).get("TZ",""))' "$ROOT/plan.json" 2>/dev/null)"
      mkdir -p "$dir/log" "$log"
      cat > "$dir/run" <<EOF
#!/bin/sh
# generated by 'immich service install' -- do not edit, re-run that instead
exec 2>&1
export PREFIX="$prefix"
export PATH="$prefix/bin:\$PATH"
# runsv is the supervisor here: it restarts us, so a TERM must not stop the stack
export SUPERVISE_STOP_STACK=0
export IMMICH_TERMUX_ROOT="$ROOT"
[ -n "$tz" ] && export TZ="$tz"
cd "$ROOT" || exit 1
termux-wake-lock 2>/dev/null || true
exec ./immich supervise
EOF
      cat > "$dir/log/run" <<EOF
#!/bin/sh
exec svlogd -tt "$log"
EOF
      # keep the svlogd log bounded: ~1 MB per file, 10 generations
      printf 's1000000\nn10\n' > "$dir/log/config"
      chmod +x "$dir/run" "$dir/log/run"
      # a 'down' file means 'do not autostart at boot'; we want the opposite
      rm -f "$dir/down"
      ok "installed $dir"
      info ""
      info "start now       : sv up $SERVICE_NAME"
      info "status          : sv status $SERVICE_NAME"
      info "restart         : sv restart $SERVICE_NAME"
      info "logs            : tail -f $log/current"
      info "stop (all)      : sv down $SERVICE_NAME && ./immich down"
      dim "  the supervisor does not stop the stack on TERM (SUPERVISE_STOP_STACK=0)"
      dim "  so './immich down' alone is undone within ${SUPERVISE_INTERVAL:-10}s"
      ;;
    uninstall)
      if [ -d "$dir" ]; then
        SVDIR="$svdir" sv down "$SERVICE_NAME" >/dev/null 2>&1
        rm -rf "$dir"
        ok "removed $dir (logs kept in $log)"
      else
        dim "$dir does not exist -- nothing to remove"
      fi
      ;;
    status|ps)
      if [ ! -d "$dir" ]; then
        dim "$SERVICE_NAME is not installed as a runit service (immich service install)"
        return 1
      fi
      if command -v sv >/dev/null 2>&1; then
        SVDIR="$svdir" sv status "$SERVICE_NAME"
      else
        dim "runit not installed: pkg install termux-services"
        return 1
      fi
      dim "  run script   : $dir/run"
      dim "  log          : $log/current"
      ;;
    *)
      err "usage: immich service [install|uninstall|status]"
      return 1
      ;;
  esac
}

usage() {
  grep -E '^# ' "$0" | sed 's/^# \{0,1\}//' | sed -n '1,40p'
}

case "${1:-help}" in
  install)  shift; cmd_install "$@" ;;
  plan)     shift; cmd_plan "$@" ;;
  pull)     shift; cmd_pull "$@" ;;
  up)       shift; cmd_up "$@" ;;
  down)     shift; cmd_down "$@" ;;
  restart)  shift; cmd_restart "$@" ;;
  status|ps) shift; cmd_status "$@" ;;
  supervise|watch) shift; cmd_supervise "$@" ;;
  service)  shift; cmd_service "$@" ;;
  logs)     shift; cmd_logs "$@" ;;
  shell)    shift; cmd_shell "$@" ;;
  exec)     shift; cmd_exec "$@" ;;
  env)      shift; cmd_env "$@" ;;
  url)      shift; cmd_url "$@" ;;
  doctor)   shift; cmd_doctor "$@" ;;
  tunnel)   shift; cmd_tunnel "$@" ;;
  prune)    shift; cmd_prune "$@" ;;
  version|--version) cmd_version ;;
  help|-h|--help) usage ;;
  *) err "unknown command: $1"; info ""; usage; exit 1 ;;
esac